TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=

# Video Source (0 for default webcam, video.mp4, or rtsp://...)
VIDEO_SOURCE=0
