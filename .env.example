# GUARDIA AI Environment Variables Configuration
# Copy this file to .env and fill in your credentials

# Telegram Bot Alert Channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook Alert Channel
DISCORD_WEBHOOK_URL=

# WhatsApp CallMeBot Channel
ALERT_WHATSAPP_TO=
